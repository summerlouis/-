{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bao-dumpling-api",
  "main": ".wrangler/bao-build/standalone.mjs",
  "no_bundle": true,
  "build": {
    "command": "node scripts/build-bao.mjs",
    "watch_dir": [
      "worker",
      "lib",
      "app/api"
    ]
  },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "BAO_STANDALONE": "true",
    "PAYMENT_MODE": "mock",
    "STORE_ID": "bao-cloud-demo"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bao-dumpling-demo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_EVENTS",
        "class_name": "OrderEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrderEvents"
      ]
    }
  ]
}
